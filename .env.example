# weibo CLI — 复制为 .env 后填写：cp .env.example .env

# ── 必填：火山方舟 API Key ──
WEIBO_ARK_API_KEY=
# 备用：ARK_API_KEY 或 CHANGDU_ARK_API_KEY

# ── 可选：Ark 网关（默认北京）──
# WEIBO_ARK_BASE_URL=https://ark.cn-beijing.volces.com

# ── Seedance 视频（weibo；模型名或 ep- 接入点）──
# 默认：doubao-seedance-2-0-260128
WEIBO_SEEDANCE_ENDPOINT=doubao-seedance-2-0-260128

# ── 其它方舟接入点（可选）──
# WEIBO_SEED_TEXT_ENDPOINT=
# WEIBO_SEEDREAM_ENDPOINT=

# ── 可选：轮询与超时（秒）──
# WEIBO_REQUEST_TIMEOUT=120
# WEIBO_POLL_INTERVAL=10
# WEIBO_POLL_MAX_WAIT=900

# ── 可选：火山 TOS ──
# WEIBO_TOS_BUCKET=
# WEIBO_TOS_ENDPOINT=tos-cn-beijing.volces.com
# WEIBO_TOS_REGION=cn-beijing
# VOLC_ACCESSKEY=
# VOLC_SECRETKEY=
